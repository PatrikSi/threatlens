# For a local first run, prefer `./bootstrap.sh`.
# Docker Compose reads `.env` automatically when present, but the compose file
# does not require one. Portainer users can run `./bootstrap.sh --print-compose-env`
# and replace the environment mapping blocks at the top of `docker-compose.yml`.
# These values are production-oriented defaults for the provided compose stack.
# For an HTTP-only local trial, set `APP_ENV=development` and `AUTH_COOKIE_SECURE=false`.
POSTGRES_DB=threatlens
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
REDIS_PASSWORD=replace-with-long-random-redis-password
# Optional: leave blank for the bundled Postgres and Redis services. Set these
# only when pointing the backend at external services.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
APP_DATA_ENCRYPTION_KEY=replace-with-separate-long-random-secret
APP_DATA_ENCRYPTION_PREVIOUS_KEYS=
REQUIRE_EXPLICIT_DATA_ENCRYPTION_KEY=true
JWT_EXPIRES_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password
APP_ENV=production
ALLOW_SELF_REGISTRATION=false
ALLOW_LEGACY_UNSCOPED_TOKENS=false
DEFAULT_API_TOKEN_EXPIRY_DAYS=90
AI_ENABLED=false
AI_API_KEY=
# Optional public browser URL used in report notification links.
PUBLIC_APP_URL=
EXPOSE_API_DOCS_IN_PRODUCTION=false
EXPOSE_OPENAPI_SCHEMA_IN_PRODUCTION=true
FEED_MAX_BYTES=2000000
FETCH_USER_AGENT=ThreatLensBot/1.0 (+https://localhost)
FEED_CONNECT_TIMEOUT_SECONDS=5
FEED_READ_TIMEOUT_SECONDS=15
ARTICLE_CONNECT_TIMEOUT_SECONDS=5
ARTICLE_READ_TIMEOUT_SECONDS=20
ARTICLE_MAX_BYTES=4000000
# Feed and article fetches, AI provider calls, notification webhooks, and OIDC each
# have separate deny-by-default private-network toggles. Keep them false unless
# you explicitly trust the internal targets.
ALLOW_PRIVATE_NETWORK_FETCH=false
ALLOW_PRIVATE_NETWORK_AI=false
ALLOW_PRIVATE_NETWORK_WEBHOOKS=false
ALLOW_PRIVATE_NETWORK_OIDC=false
# Keep false outside isolated development networks. Public HTTP OIDC requires
# this flag. Private HTTP remains compatible with ALLOW_PRIVATE_NETWORK_OIDC;
# set both flags to make the plaintext and private-network trust explicit.
ALLOW_INSECURE_HTTP_OIDC=false
OUTBOUND_MAX_REDIRECTS=5
PER_DOMAIN_CONCURRENCY=2
WORKER_CONCURRENCY=4
AI_WORKER_CONCURRENCY=1
MAINTENANCE_WORKER_CONCURRENCY=1
NOTIFICATION_WORKER_CONCURRENCY=4
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_IP_MAX_ATTEMPTS=50
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCKOUT_SECONDS=900
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_POOL_TIMEOUT_SECONDS=10
API_TOKEN_LAST_USED_UPDATE_INTERVAL_SECONDS=300
OIDC_TRANSACTION_COOKIE_NAME=threatlens_oidc_transaction
OIDC_TRANSACTION_TTL_SECONDS=600
# Keep the default when using the bundled web proxy. A directly exposed API
# normally uses /v1/auth/oidc/callback instead.
OIDC_CALLBACK_PATH=/api/v1/auth/oidc/callback
OIDC_METADATA_CACHE_SECONDS=300
OIDC_CONNECT_TIMEOUT_SECONDS=5
OIDC_READ_TIMEOUT_SECONDS=10
OIDC_MAX_RESPONSE_BYTES=1000000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Trust only exact proxy hops you control. The bundled stack resolves the `web`
# service through Docker DNS; use CIDRs for custom external reverse proxies.
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HOSTS=web
# Backend Host header allowlist. The bundled web proxy forwards requests to the
# API service host `api`; add external hostnames here if you expose the backend
# service directly or through a custom proxy that preserves the public Host.
ALLOWED_HOSTS=api,localhost,127.0.0.1,::1
# The published browser API base is versioned. For non-proxied deployments,
# set this to the full external API origin, for example https://api.example.com/v1.
WEB_VITE_API_BASE_URL=/api/v1
# Host port for the bundled web UI.
THREATLENS_WEB_PORT=3000
# Published image tag to pull. `latest` tracks the newest default published image.
# Use an immutable release tag such as 1.0.0 or a sha-* tag to pin an install.
THREATLENS_IMAGE_TAG=latest
# Runtime Content-Security-Policy sources rendered by the web container.
# `frame-src` allows the dashboard's sandboxed original-article preview endpoint.
THREATLENS_CSP_CONNECT_SRC="'self'"
THREATLENS_CSP_FRAME_SRC="'self'"
# Optional transient OCI image label inputs. Export fresh values in the shell
# before building from source with `docker-compose.build.yml`; do not persist
# APP_VERSION here because an old value would override the checked-in release:
#   export APP_VERSION="$(cat VERSION)"
#   export BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
#   export VCS_REF="$(git rev-parse HEAD)"
AUTH_COOKIE_NAME=threatlens_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_CSRF_COOKIE_NAME=threatlens_csrf
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_REQUIRE_CSRF=true

PROBE_FEED_METADATA_ON_CREATE=false
PROBE_FEED_METADATA_ON_IMPORT=false
MAX_METADATA_BACKFILL_TASKS_PER_REQUEST=100
DISPATCH_DUE_FEEDS_BATCH_SIZE=500
DISPATCH_FEED_CLAIM_SECONDS=900
DISPATCH_ITEMS_MISSING_ARTICLES_BATCH_SIZE=200
DISPATCH_ITEMS_MISSING_ARTICLES_AFTER_SECONDS=300
DISPATCH_UNCLASSIFIED_ITEMS_BATCH_SIZE=200
DISPATCH_ITEMS_MISSING_IOCS_BATCH_SIZE=200
DISPATCH_ITEMS_MISSING_AI_ENRICHMENT_BATCH_SIZE=200
DISPATCH_ITEMS_FAILED_AI_ENRICHMENT_AFTER_SECONDS=3600
AI_AUTO_ENRICH_NEW_ITEM_MAX_AGE_HOURS=24
AI_DAILY_BRIEF_SOURCE_AUDIT_LIMIT=500
DISPATCH_FEED_METADATA_SCAN_LIMIT=250
DISPATCH_FEED_METADATA_QUEUE_LIMIT=50
DISPATCH_AI_REPROCESS_BATCH_SIZE=100
# Celery must retain unacknowledged long-running AI work longer than the report
# generation lease. Report schedule/dispatch retries use capped exponential backoff.
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
REPORT_GENERATION_LEASE_SECONDS=600
REPORT_LEGACY_WORKER_GRACE_SECONDS=86400
REPORT_SCHEDULE_MAX_ATTEMPTS=5
REPORT_SCHEDULE_RETRY_BACKOFF_SECONDS=60
REPORT_SCHEDULE_RETRY_MAX_BACKOFF_SECONDS=3600
REPORT_DISPATCH_BATCH_SIZE=100
REPORT_DISPATCH_MAX_ATTEMPTS=10
REPORT_DISPATCH_CLAIM_SECONDS=60
REPORT_DISPATCH_RETRY_BACKOFF_SECONDS=15
REPORT_DISPATCH_RETRY_MAX_BACKOFF_SECONDS=900

ALERT_MATCHES_KEYWORD_CAP=512
STATS_TOP_DOMAINS_LIMIT=10

# Article exports are generated into temporary files and bounded by both item
# count and uncompressed output size. PDF bundles have a lower item ceiling.
EXPORT_MAX_ITEMS=10000
EXPORT_PDF_MAX_ITEMS=500
EXPORT_PREVIEW_LIMIT=25
EXPORT_MAX_UNCOMPRESSED_BYTES=250000000
EXPORT_LOCK_TTL_SECONDS=900

RUN_MIGRATIONS_ON_STARTUP=true
# For first boot, either set this to true for one startup or run
# `docker compose exec api python -m app.scripts.seed_admin` after migrations.
# Set it back to false for steady state, and keep the password-reset flag off
# unless you are intentionally rotating credentials at startup.
SEED_ADMIN_ON_STARTUP=false
SEED_ADMIN_FORCE_ROLE=false
SEED_ADMIN_REACTIVATE_EXISTING=false
SEED_ADMIN_RESET_PASSWORD_ON_STARTUP=false

LOG_LEVEL=INFO
# Optional comma-separated per-logger thresholds, for example app.services.oidc_client=DEBUG,httpx=WARNING.
LOG_LEVEL_OVERRIDES=
# text is optimized for humans; json is intended for Loki, ELK, Splunk, and similar collectors.
LOG_FORMAT=text
# verbose adds safe request and worker-task lifecycle diagnostics. Request bodies, cookies, credentials,
# authorization headers, SMTP secrets, and OIDC tokens are never logged.
LOG_DETAIL=standard
# Client addresses can be personal data. Enable only when operationally necessary.
LOG_INCLUDE_CLIENT_IP=false
LOG_SLOW_REQUEST_MS=1000
LOG_MAX_EVENT_CHARS=20000
# Logs SQL statements at INFO with bound parameter values hidden.
LOG_SQL=false
HEALTH_WORKER_PING_TIMEOUT_SECONDS=1.0
BEAT_HEARTBEAT_KEY=threatlens:beat:heartbeat
BEAT_SCHEDULER_HEARTBEAT_KEY=threatlens:beat:scheduler-heartbeat
BEAT_HEARTBEAT_TTL_SECONDS=180
BEAT_HEARTBEAT_STALE_AFTER_SECONDS=180
BEAT_HEARTBEAT_INTERVAL_SECONDS=60
BEAT_WATCHDOG_STARTUP_GRACE_SECONDS=240
BEAT_WATCHDOG_CHECK_INTERVAL_SECONDS=15
BEAT_WATCHDOG_TERMINATE_TIMEOUT_SECONDS=10
NOTIFICATION_DELIVERY_ENQUEUE_BATCH_SIZE=100
NOTIFICATION_DELIVERY_RECOVERY_BATCH_SIZE=100
NOTIFICATION_DELIVERY_SENDING_STALE_AFTER_SECONDS=120
NOTIFICATION_DELIVERY_QUEUE_DEGRADED_AFTER_SECONDS=300
NOTIFICATION_DELIVERY_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_DELIVERY_RETRY_BACKOFF_SECONDS=30
INTEGRATION_EVENT_ROUTING_BATCH_SIZE=200
INTEGRATION_EVENT_ROUTING_STALE_AFTER_SECONDS=120
INTEGRATION_EVENT_ROUTING_MAX_ATTEMPTS=10
INTEGRATION_EVENT_ROUTING_BACKOFF_SECONDS=10
INTEGRATION_DELIVERY_RECOVERY_BATCH_SIZE=200
INTEGRATION_DELIVERY_RETRY_MAX_ATTEMPTS=5
INTEGRATION_DELIVERY_RETRY_BACKOFF_SECONDS=30
INTEGRATION_DELIVERY_RETRY_MAX_BACKOFF_SECONDS=3600
INTEGRATION_DELIVERY_CONCURRENCY_DEFER_SECONDS=5
INTEGRATION_DELIVERY_CIRCUIT_FAILURE_THRESHOLD=5
INTEGRATION_DELIVERY_CIRCUIT_OPEN_SECONDS=300
INTEGRATION_DELIVERY_METRICS_DELAY_SECONDS=60
INTEGRATION_DELIVERY_MAINTENANCE_BATCH_SIZE=1000
INTEGRATION_DELIVERY_RETENTION_DAYS=90
INTEGRATION_EVENT_RETENTION_DAYS=30
INTEGRATION_METRICS_RETENTION_DAYS=730
AUDIT_LOG_RETENTION_DAYS=730
AI_TASK_HISTORY_RETENTION_DAYS=180
AI_USAGE_RETENTION_DAYS=730
TAG_FEEDBACK_RETENTION_DAYS=730
INTEGRATION_RUN_RETENTION_DAYS=180
