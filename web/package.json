{
  "name": "threatlens-web",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "audit": "audit-ci --config .audit-ci.jsonc",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "test:dist": "node scripts/smoke_production_bundle.mjs",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test:browser": "tsc -p tsconfig.browser.json && playwright test",
    "test:browser:server": "tsc -p tsconfig.browser.json && playwright test --config playwright.server.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.73.0",
    "parse-entities": "4.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "tabbable": "6.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/hast": "3.0.5",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "audit-ci": "^7.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
