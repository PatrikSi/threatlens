{
  "name": "threatlens-web",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "audit": "audit-ci --config .audit-ci.jsonc",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "test:dist": "node scripts/smoke_production_bundle.mjs",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test:browser": "tsc -p tsconfig.browser.json && playwright test",
    "test:browser:server": "tsc -p tsconfig.browser.json && playwright test --config playwright.server.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.103.0",
    "lucide-react": "^1.46.0",
    "parse-entities": "4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "tabbable": "6.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
